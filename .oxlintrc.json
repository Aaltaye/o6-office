{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "nextjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": [
    ".next/**",
    ".vinext/**",
    "out/**",
    "build/**",
    "dist/**",
    "coverage/**",
    "next-env.d.ts",
    "bridge/public/**",
    // Vendored shadcn/ui primitives. Generated third-party code we do not author or
    // review; linting it produces noise that buries findings in code we DO own.
    "components/ui/**"
  ],
  "rules": {
    "no-array-constructor": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "import/no-anonymous-default-export": "warn",
    "react/display-name": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/no-unescaped-entities": "error",
    "react/react-compiler": "error",
    // This app runs on vinext, not the Next.js router. next/link pulls in a second copy
    // of React here and throws "Invalid hook call", so plain anchors are the correct
    // and only working way to navigate between our pages.
    "nextjs/no-html-link-for-pages": "off",
    // A deliberate, stated trade-off. StationId is a string, so a union like
    // `StationId | Endpoint` collapses structurally and the rule is technically right.
    // But that union is the only place the code says "a desk, or one of the building's
    // two ends", and the alternative — branding StationId — would add casts through every
    // floor-plan literal to buy nothing at runtime. Documentation wins here.
    "typescript/no-redundant-type-constituents": "off",
    "react/require-render-return": "error",
    "react/rules-of-hooks": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error"
  }
}
